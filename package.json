{
  "name": "syntx-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfisenkov/syntx-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alexfisenkov/syntx-mcp/issues"
  },
  "description": "Extensible MCP integration for the owner-authorized SYNTX AI catalog, per-user linking, account reads, and generation workflows.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "publication-manifest.json",
    "dist/src",
    "catalog",
    "docs",
    "skills/syntx-mcp-update",
    "scripts/sync-public-catalog.mjs",
    "scripts/syntx-maintenance.mjs",
    "scripts/live-owner-upload-file-smoke.mjs",
    "scripts/live-owner-reconcile-upload-smoke.mjs",
    "scripts/check-runtime-sources.mjs",
    "scripts/check-settings-implementations.mjs",
    "scripts/settings-v5-root-only.mjs",
    "scripts/sync-settings-source-inventory.mjs",
    "scripts/sync-normalized-settings-ir.mjs",
    "scripts/sync-normalized-settings-parser-canary.mjs",
    "scripts/sync-normalized-settings-parser-census-manifest.mjs",
    "scripts/archive-versioned-settings-census.mjs",
    "scripts/sync-versioned-generic-form-result.mjs",
    "scripts/sync-normalized-settings-parser-source-backed-result.mjs",
    "scripts/source-backed-result",
    "scripts/sync-normalized-settings-parser-generic-form-result.mjs",
    "scripts/lock-signal-cleanup.mjs",
    "scripts/print-media-mcp-config.mjs"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./sqlite": {
      "types": "./dist/src/storage/sqlite-generation-transaction-store.d.ts",
      "import": "./dist/src/storage/sqlite-generation-transaction-store.js"
    }
  },
  "main": "./dist/src/index.js",
  "bin": {
    "syntx-mcp-stdio": "dist/src/transports/stdio.js",
    "syntx-mcp-http": "dist/src/transports/http.js",
    "syntx-mcp-owner-stdio": "dist/src/transports/stdio-owner.js",
    "syntx-mcp-owner-evidence": "dist/src/transports/stdio-owner-evidence.js",
    "syntx-mcp-owner-http": "dist/src/transports/http-owner.js",
    "syntx-mcp-media-config": "scripts/print-media-mcp-config.mjs",
    "syntx-settings-ir": "scripts/sync-normalized-settings-ir.mjs",
    "syntx-settings-parser": "scripts/sync-normalized-settings-parser-canary.mjs",
    "syntx-settings-census": "scripts/sync-normalized-settings-parser-census-manifest.mjs",
    "syntx-settings-source-backed": "scripts/sync-normalized-settings-parser-source-backed-result.mjs",
    "syntx-settings-generic": "scripts/sync-normalized-settings-parser-generic-form-result.mjs",
    "syntx-mcp-maintenance": "scripts/syntx-maintenance.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "catalog:check": "npm run build && node scripts/sync-public-catalog.mjs --check",
    "catalog:sync": "npm run build && node scripts/sync-public-catalog.mjs",
    "runtime:sources:check": "npm run build && node scripts/check-runtime-sources.mjs",
    "settings:sources:check": "npm run build && node scripts/sync-settings-source-inventory.mjs --check",
    "settings:sources:sync": "npm run build && node scripts/sync-settings-source-inventory.mjs",
    "settings:implementations:check": "node scripts/check-settings-implementations.mjs",
    "settings:v5:check": "node scripts/settings-v5-root-only.mjs --check --form-id beeble",
    "settings:v5:probe": "node scripts/settings-v5-root-only.mjs --probe-source --form-id beeble --confirm-source-fetch",
    "settings:v5:sync": "node scripts/settings-v5-root-only.mjs --sync-source --form-id beeble --confirm-source-fetch",
    "settings:helper:probe": "npm run build && node scripts/settings-helper-constants.mjs --probe",
    "settings:helper:archive": "npm run build && node scripts/settings-helper-constants.mjs --archive",
    "settings:helper:inspect": "npm run build && node scripts/settings-helper-constants.mjs --inspect",
    "settings:alternate-identity:archive": "npm run build && node scripts/settings-alternate-identity.mjs --archive",
    "settings:alternate-identity:inspect": "npm run build && node scripts/settings-alternate-identity.mjs --inspect",
    "settings:ir:check": "node scripts/sync-normalized-settings-ir.mjs --check",
    "settings:ir:check:source": "npm run build && npm run settings:ir:check",
    "settings:ir:sync": "npm run build && node scripts/sync-normalized-settings-ir.mjs --sync",
    "settings:parser:check": "node scripts/sync-normalized-settings-parser-canary.mjs --check",
    "settings:parser:check:source": "node scripts/sync-normalized-settings-parser-canary.mjs --check-source --confirm-source-fetch",
    "settings:parser:sync": "node scripts/sync-normalized-settings-parser-canary.mjs --sync-source --confirm-source-fetch",
    "settings:census:check": "node scripts/sync-normalized-settings-parser-census-manifest.mjs --check",
    "settings:census:check:local": "node scripts/sync-normalized-settings-parser-census-manifest.mjs --check-local",
    "settings:census:sync:local": "node scripts/sync-normalized-settings-parser-census-manifest.mjs --sync-local",
    "settings:source-backed:check": "node scripts/sync-normalized-settings-parser-source-backed-result.mjs --check",
    "settings:source-backed:probe": "node scripts/sync-normalized-settings-parser-source-backed-result.mjs --probe-source --confirm-source-fetch",
    "settings:source-backed:check:source": "node scripts/sync-normalized-settings-parser-source-backed-result.mjs --check-source --confirm-source-fetch",
    "settings:source-backed:sync": "node scripts/sync-normalized-settings-parser-source-backed-result.mjs --sync-source --confirm-source-fetch",
    "settings:generic:check": "node scripts/sync-normalized-settings-parser-generic-form-result.mjs --check",
    "settings:generic:probe": "node scripts/sync-normalized-settings-parser-generic-form-result.mjs --probe-source --confirm-source-fetch",
    "settings:generic:check:source": "node scripts/sync-normalized-settings-parser-generic-form-result.mjs --check-source --confirm-source-fetch",
    "settings:generic:sync": "node scripts/sync-normalized-settings-parser-generic-form-result.mjs --sync-source --confirm-source-fetch",
    "settings:census:archive-versioned": "npm run build && node scripts/archive-versioned-settings-census.mjs",
    "settings:generic:sync-versioned": "npm run build && node scripts/sync-versioned-generic-form-result.mjs",
    "package:smoke": "npm run build && node scripts/check-package-install.mjs",
    "package:smoke:public": "npm run build && node scripts/check-package-install.mjs --public-source",
    "package:cache:prime": "node scripts/prime-package-test-cache.mjs",
    "live:owner:smoke": "npm run build && node scripts/live-owner-smoke.mjs --confirm-live-owner-smoke",
    "live:owner:chat-smoke": "npm run build && node scripts/live-owner-chat-smoke.mjs --confirm-live-owner-chat-smoke",
    "live:owner:account-status-smoke": "npm run build && node scripts/live-owner-account-status-smoke.mjs --confirm-live-owner-account-status-smoke",
    "live:owner:uploaded-files-smoke": "npm run build && node scripts/live-owner-uploaded-files-smoke.mjs --confirm-live-owner-uploaded-files-smoke",
    "live:owner:uploaded-files-hidden-smoke": "npm run build && node scripts/live-owner-uploaded-files-hidden-smoke.mjs --confirm-live-owner-uploaded-files-hidden-smoke",
    "live:owner:uploaded-files-shape-smoke": "npm run build && node scripts/live-owner-uploaded-files-shape-smoke.mjs --confirm-live-owner-uploaded-files-shape-smoke",
    "live:owner:upload-file-smoke": "npm run build && node scripts/live-owner-upload-file-smoke.mjs --confirm-live-owner-upload-file-smoke",
    "live:owner:reconcile-upload-smoke": "npm run build && node scripts/live-owner-reconcile-upload-smoke.mjs --confirm-live-owner-reconcile-upload-smoke",
    "live:owner:image-contract": "npm run build && node scripts/live-owner-image-contract-observe.mjs --confirm-live-image-contract",
    "live:owner:generate-video-smoke": "npm run build && node scripts/live-owner-generate-video-tool-smoke.mjs --confirm-live-generate-video-tool-smoke",
    "live:owner:wan-i2v-smoke": "npm run build && node scripts/live-owner-wan-i2v-smoke.mjs --confirm-live-wan-i2v-smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js tests/syntx-maintenance-cli.test.mjs tests/print-media-mcp-config.test.mjs tests/public-source-package-manifest.test.mjs tests/export-public-snapshot.test.mjs tests/public-secret-scan.test.mjs tests/prime-package-test-cache.test.mjs tests/public-source-line-endings.test.mjs",
    "test:media:changed": "node --test dist/tests/owner-veo-omni-source-join-2087.test.js dist/tests/owner-veo-omni-source-tools-2087.test.js dist/tests/owner-veo-omni-t2v-profile-2088.test.js dist/tests/owner-veo-omni-t2v-budget-2092.test.js dist/tests/owner-veo-omni-t2v-service-2092.test.js dist/tests/owner-veo-omni-t2v-tools-2093.test.js dist/tests/owner-veo-omni-t2v-runtime-2095.test.js && node --test --test-name-pattern=\"static.report|read-only\" dist/tests/owner-veo-omni-parameters-2054.test.js dist/tests/owner-veo-omni-parameter-tools-2055.test.js && node --test --test-name-pattern=\"Omni.T2V.config|emitted.JSON.has.absolute|Live.installed.config|installed.config.smoke.pins.Omni|changed-media.selector\" tests/print-media-mcp-config.test.mjs",
    "start:http": "node dist/src/transports/http.js",
    "start:stdio": "node dist/src/transports/stdio.js",
    "start:owner:http": "node dist/src/transports/http-owner.js",
    "start:owner:stdio": "node dist/src/transports/stdio-owner.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
